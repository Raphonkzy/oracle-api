# Copy to .env and fill in. Never commit .env.

# Database (matches docker-compose.dev.yml defaults)
POSTGRES_USER=oracle
POSTGRES_PASSWORD=oracle_dev_password
POSTGRES_DB=oracle
POSTGRES_PORT=5433
DATABASE_URL=postgres://oracle:oracle_dev_password@localhost:5433/oracle

# Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Who can create an account:
#   closed = only the first user (the owner) can sign up
#   open   = anyone can sign up
SIGNUP_MODE=closed

# Oracle API (api/)
# Public URL of the API, as the phone and browser reach it.
API_URL=http://localhost:3200
PORT=3200
# Comma-separated browser origins allowed to call the API (only needed for the web build).
CORS_ORIGINS=

# AI assistant (any OpenAI-compatible endpoint). Leave AI_API_KEY empty to turn the assistant off.
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
# Email for the "Forgot password" code. Leave SMTP_HOST empty to turn it off (then use reset-password.sh).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
