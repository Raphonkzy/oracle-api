# Copy to backend/.env.production and fill in. Never commit it.
# Used with: docker compose --env-file backend/.env.production -f backend/docker-compose.prod.yml ...

# Database. Use letters and digits only in the password (it goes into a URL). Make one with: openssl rand -hex 24
POSTGRES_USER=oracle
POSTGRES_PASSWORD=
POSTGRES_DB=oracle

# Session signing key, at least 32 characters. Make one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public https address of the API (the hostname on your Cloudflare Tunnel). The phone app is built with this same address.
API_URL=https://oracle.example.com

# closed = only the first account (the owner) can sign up. Keep it closed after you made yours.
SIGNUP_MODE=closed

# Browser origins that may call the API, only for the web build. Leave empty for the phone app alone.
CORS_ORIGINS=
# AI assistant (any OpenAI-compatible endpoint). Leave AI_API_KEY empty to turn it off. Never commit the real key.
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
# Sent to the provider as reasoning_effort. Default: none. Leave it empty to send no reasoning_effort field.
AI_REASONING_EFFORT=none
# Questions and summaries per person per hour.
AI_RATE_PER_HOUR=40
# Email, only used to send the "Forgot password" code. Leave SMTP_HOST empty to turn "Forgot password" off.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=an "app password" (Google Account, Security, 2-Step Verification, App passwords), SMTP_FROM="Oracle <you@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# Backups
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
